DATABASE_URL=postgresql+psycopg://colo:colo@postgres:5432/colo
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
STORAGE_DIR=/app/storage

LLM_BASE_URL=http://internal-llm.company.local/v1
LLM_API_KEY=changeme
LLM_SMALL_MODEL=internal-9b
LLM_MEDIUM_MODEL=internal-14b
LLM_TIMEOUT_SECONDS=120

BACKEND_CORS_ORIGINS=http://localhost:3000

# Embedding / vector retrieval settings
# EMBEDDING_PROVIDER=local uses sentence-transformers locally (for example Qwen3-Embedding).
# EMBEDDING_PROVIDER=openai calls an OpenAI-compatible /embeddings endpoint
# (for example text-embedding-3-small or text-embedding-3-large).
# Embedding text is processed locally by sentence-transformers and is not uploaded
# for embedding. Keep local-files-only enabled in firewalled deployments; pre-download
# or mount the model, or set EMBEDDING_LOCAL_FILES_ONLY=false only where model downloads are allowed.
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60
SEARCH_CANDIDATE_LIMIT=200
VECTOR_SCORE_THRESHOLD=0.05
EMBEDDING_LOCAL_FILES_ONLY=true

