DATABASE_URL=postgresql+psycopg://colo:colo@postgres:5432/colo
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
STORAGE_DIR=/app/storage

LLM_BASE_URL=http://internal-llm.company.local/v1
LLM_API_KEY=changeme
LLM_SMALL_MODEL=internal-9b
LLM_MEDIUM_MODEL=internal-14b
LLM_TIMEOUT_SECONDS=120

BACKEND_CORS_ORIGINS=http://localhost:3000
# Embedding text is processed locally by sentence-transformers. The model may
# be downloaded from Hugging Face, but document text is not uploaded for embedding.
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_LOCAL_FILES_ONLY=false

